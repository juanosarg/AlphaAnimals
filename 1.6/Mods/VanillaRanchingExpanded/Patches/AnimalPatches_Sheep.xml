<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AA_DevilSheep"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="AA_DevilSheep"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AA_DevilSheep"]/comps</xpath>
		<value>
			<li Class="VanillaRanchingExpanded.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AA_DevilSheep"]/race</xpath>
		<value>
			<canCrossBreedWith>
				<li>Sheep</li>
				<li>VRE_MerinoSheep</li>
				<li>VRE_DorperSheep</li>
				<li>VRE_DairySheep</li>
				<li>VRE_ShaggySheep</li>
			</canCrossBreedWith>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="AA_DevilSheep"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.AnimalCrossbreedExtension">
				<crossBreedKindDef>Random</crossBreedKindDef>
				<weightForMother>0.6</weightForMother>
			</li>
		</value>
	</Operation>
</Patch>

